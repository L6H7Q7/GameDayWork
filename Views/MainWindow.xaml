<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:m="clr-namespace:GameOrchestrator.Models" xmlns:i="clr-namespace:GameOrchestrator.Infrastructure" xmlns:v="clr-namespace:GameOrchestrator.Views" x:Class="GameOrchestrator.Views.MainWindow" Title="GameDayWork" Icon="/GameDayWork;component/Assets/GameDayWork-Idle.ico" Width="900" Height="700" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#EEF4FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14">
  <Window.Resources>
    <Style x:Key="PageButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#1677F2"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource PageButton}"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PageButton}">
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#2563EB"/>
    </Style>
    <i:EnumDisplayConverter x:Key="EnumDisplay"/>
    <DataTemplate x:Key="EnumDisplayTemplate">
      <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}"/>
    </DataTemplate>
    <i:ExecutableIconConverter x:Key="ExecutableIcon"/>
    <i:LogLevelBrushConverter x:Key="LogBrush"/>
    <i:EnumEqualsToVisibilityConverter x:Key="CompletionModeVisibility"/>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0B1735"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#203456"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinWidth" Value="38"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="FontSize" Value="17"/>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="18,8"/>
    </Style>
    <Style x:Key="Group" TargetType="Border">
      <Setter Property="Background" Value="#F3F6FA"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,12,0,8"/>
    </Style>
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Track" Width="42" Height="22" CornerRadius="11" Background="#CBD5E1">
                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#1E78F0"/>
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource PageButton}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="5,4"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="MinWidth" Value="28"/>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#D9E4F2" BorderThickness="1" CornerRadius="12" Background="#F4F8FD">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Border MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="#EAF3FF">
        <Grid Margin="18,0,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="GameDayWork" FontSize="21" FontWeight="Bold" Foreground="#071536"/>
            <TextBlock Text="v5.0.0" Foreground="#6E7F9C" Margin="12,5,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="HomeButton" Content="主页" Click="Home_Click" MinWidth="68" Margin="0,0,8,0"/>
            <Button x:Name="ExecutionButton" Content="{Binding ManualActionText}" Click="Execution_Click" Style="{StaticResource PrimaryButton}" MinWidth="92" Margin="0,0,8,0"/>
            <Button Content="设置" Click="Settings_Click" MinWidth="68" Margin="0,0,8,0"/>
            <Button Content="—" Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Click="Minimize_Click"/>
            <Button Content="□" Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Click="Maximize_Click"/>
            <Button Content="×" Style="{StaticResource IconButton}" Background="Transparent" BorderThickness="0" Click="Close_Click"/>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="14,14,14,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="252"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="TasksPage" Style="{StaticResource Card}" Padding="10" Visibility="Visible" Grid.Column="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="2,2,2,12">
              <TextBlock Text="{Binding Tasks.Count,StringFormat=任务列表（{0}）}" Style="{StaticResource Title}" FontSize="18" Margin="0,0,0,12"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="AddTaskButton" Content="＋ 添加" Click="AddTask_Click" Style="{StaticResource SidebarButton}" Margin="0,0,4,0"/>
                <Button x:Name="DeleteTaskButton" Content="删除" Click="DeleteTask_Click" Style="{StaticResource SidebarButton}" Margin="0,0,4,0"/>
                <Button x:Name="DuplicateTaskButton" Content="复制" Click="DuplicateTask_Click" Style="{StaticResource SidebarButton}" Margin="0,0,4,0"/>
                <Button x:Name="MoveUpButton" Content="↑" Click="MoveUp_Click" Style="{StaticResource SidebarButton}" Margin="0,0,4,0"/>
                <Button x:Name="MoveDownButton" Content="↓" Click="MoveDown_Click" Style="{StaticResource SidebarButton}" Margin="0,0,4,0"/>
              </StackPanel>
            </StackPanel>
            <Grid DockPanel.Dock="Bottom" Margin="4,12,4,0">
              <TextBlock Text="{Binding AutoSaveMessage}" Foreground="#6D7F9D" FontSize="12" TextWrapping="Wrap"/>
            </Grid>
            <Grid>
              <ListBox x:Name="TaskList" ItemsSource="{Binding VisibleTasks}" SelectedItem="{Binding SelectedTask}" BorderThickness="0" Background="Transparent" Padding="0" AllowDrop="True" SelectionChanged="TaskList_SelectionChanged" PreviewMouseLeftButtonUp="TaskList_MouseUp" PreviewKeyDown="TaskList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonDown="TaskList_MouseDown" PreviewMouseMove="TaskList_MouseMove" Drop="TaskList_Drop">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,1"/>
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <Border x:Name="R" BorderBrush="#EDF1F6" BorderThickness="0,0,0,1" Padding="5,9" CornerRadius="8">
                            <ContentPresenter/>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="R" Property="Background" Value="#E8F3FF"/>
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsGroupChild}" Value="True">
                        <Setter Property="Margin" Value="18,1,0,1"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type m:AutomationTaskConfig}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding GroupIndicator}" Foreground="#6E7F99" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Width="46" Height="46" CornerRadius="9" Background="#34445D">
                        <TextBlock Text="{Binding IconText}" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <Image Grid.Column="1" Source="{Binding ProgramPath,Converter={StaticResource ExecutableIcon}}" Width="38" Height="38" Stretch="Uniform"/>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <TextBlock Text="{Binding ScheduleLabel}" Foreground="#6E7F99" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="暂无任务，点击添加。" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6D7F9D" IsHitTestVisible="False">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Tasks.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </DockPanel>
        </Border>
        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="1">
            <Grid x:Name="HomePage">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="当前状态" Foreground="#6D7F9D"/>
                    <TextBlock Text="{Binding ScreenStateText}" FontSize="28" FontWeight="SemiBold" Foreground="#0B1735" Margin="0,6,0,0"/>
                    <TextBlock Text="{Binding CurrentStatusHeadline}" FontSize="16" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding CurrentStatusHint}" Foreground="#73839E" Margin="0,6,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                    <TextBlock Text="{Binding StatusText}" Foreground="#355179" Margin="0,0,22,4"/>
                    <TextBlock Text="{Binding Elapsed,StringFormat=运行时间：{0}}" Foreground="#6D7F9D" Margin="0,0,22,4"/>
                    <TextBlock Text="{Binding RelatedCount,StringFormat=关联进程：{0}}" Foreground="#6D7F9D" Margin="0,0,22,4"/>
                    <TextBlock Text="{Binding RootPid,StringFormat=主 PID：{0}}" Foreground="#6D7F9D" Margin="0,0,0,4"/>
                  </WrapPanel>
                  <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding NextRunText,StringFormat=下次执行：{0}}" ToolTip="{Binding NextTaskNames}" Foreground="#6D7F9D" Margin="0,8,0,0"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="执行日志" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Content="清空" Click="ClearLogs_Click"/>
                      <Button Content="导出" Click="ExportLogs_Click" Margin="8,0"/>
                      <ComboBox x:Name="LogFilter" Width="90">
                        <ComboBoxItem Content="全部" IsSelected="True"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日志持续更新" Foreground="#6D7F9D" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="打开日志文件夹" Command="{Binding OpenLogsCommand}"/>
                  </Grid>
                  <Separator DockPanel.Dock="Top"/>
                  <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.ScrollUnit="Pixel" Loaded="LogList_Loaded" IsVisibleChanged="LogList_IsVisibleChanged" ScrollViewer.ScrollChanged="LogList_ScrollChanged">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="{x:Type m:LogEntry}">
                        <Grid Margin="0,5">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding TimeText}" Foreground="#8191AB"/>
                          <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding Level,Converter={StaticResource LogBrush}}"/>
                          <Border Grid.Column="2" Background="#EAF2FF" CornerRadius="10" Padding="7,2" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding LevelText}" FontSize="12" Foreground="{Binding Level,Converter={StaticResource LogBrush}}"/>
                          </Border>
                          <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>
            </Grid>
            <Border x:Name="TaskEditPage" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
              <DockPanel>
                <Grid>
                <ScrollViewer x:Name="GroupSettingsPanel" Visibility="Collapsed">
                  <StackPanel Margin="4,12">
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="任务组名称" Style="{StaticResource Label}"/>
                      <TextBox Grid.Column="1" Text="{Binding EditingTask.Name,UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="启动时间" Style="{StaticResource Label}"/>
                      <v:TaskTimeSelector x:Name="GroupStartTimeSelector" Grid.Column="1" Grid.ColumnSpan="2" HorizontalAlignment="Left" Width="200"
                                          Time="{Binding EditingTask.ScheduledStartTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <Grid Margin="0,0,0,12">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                      <TextBlock Text="任务间隔" Style="{StaticResource Label}"/>
                      <TextBox x:Name="GroupIntervalInput" Grid.Column="1" Text="{Binding EditingTask.GroupTaskIntervalSeconds}"/>
                      <TextBlock Grid.Column="2" Text="秒，上一项清理后等待" Foreground="#6E7F99" VerticalAlignment="Center" Margin="12,0"/>
                    </Grid>
                    <Border Style="{StaticResource Group}"><TextBlock Text="组内任务" FontWeight="SemiBold"/></Border>
                    <WrapPanel Margin="0,0,0,12">
                      <Button x:Name="AddGroupTaskButton" Content="＋ 添加任务" Click="AddGroupTask_Click"/>
                      <Button Content="移除" Click="RemoveGroupTask_Click" Margin="8,0,0,0"/>
                      <Button Content="上移" Click="MoveGroupTaskUp_Click" Margin="8,0,0,0"/>
                      <Button Content="下移" Click="MoveGroupTaskDown_Click" Margin="8,0,0,0"/>
                    </WrapPanel>
                    <ListBox x:Name="GroupMembersList" ItemsSource="{Binding EditingTask.Children}" DisplayMemberPath="Name" MinHeight="160"/>
                    <TextBlock Text="按列表顺序执行，完成后继续组内下一项。" Foreground="#6E7F99" Margin="0,12,0,0"/>
                    <TextBlock Text="添加、移除和排序会保存当前组设置。" Foreground="#6E7F99" Margin="0,6,0,0"/>
                  </StackPanel>
                </ScrollViewer>
                    <ScrollViewer x:Name="TaskSettingsPanel" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
  <ScrollViewer.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="8,5"/></Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Height" Value="36"/><Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="6,0"/></Style>
  </ScrollViewer.Resources>
  <StackPanel Margin="4,8">
    <Grid x:Name="TaskIdentityRow" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="任务名称" Margin="0,0,0,6"/>
        <TextBox x:Name="TaskNameInput" Text="{Binding EditingTask.Name,UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
      <Grid x:Name="TypeAndRepository" Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition>
            <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="12"/><Style.Triggers><DataTrigger Binding="{Binding EditingTask.RepositoryUrl}" Value=""><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
          </ColumnDefinition>
          <ColumnDefinition>
            <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*"/><Style.Triggers><DataTrigger Binding="{Binding EditingTask.RepositoryUrl}" Value=""><Setter Property="Width" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
          </ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditingTask.RepositoryUrl}" Value=""><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="任务类型" Margin="0,0,0,6"/>
          <ComboBox x:Name="ToolTypeSelector" ItemsSource="{Binding ToolTypes}" SelectedItem="{Binding EditingTask.ToolType,Mode=OneWay}" SelectionChanged="ToolType_SelectionChanged"/>
        </StackPanel>
        <StackPanel x:Name="RepositoryField" Grid.Column="2">
          <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding EditingTask.RepositoryUrl}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
          <TextBlock Text="仓库地址" Margin="0,0,0,6"/>
          <Button x:Name="RepositoryButton" Content="打开 Git 仓库" Click="OpenRepository_Click" ToolTip="{Binding EditingTask.RepositoryUrl}"/>
        </StackPanel>
      </Grid>
    </Grid>
    <Grid x:Name="TaskLaunchRow" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="程序路径" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TaskPathInput" Text="{Binding EditingTask.ProgramPath,UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding EditingTask.ProgramPath}"/>
          <Button x:Name="BrowseTaskButton" Grid.Column="2" Content="…" Click="Browse_Click" ToolTip="选择程序路径"/>
        </Grid>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="启动参数" Margin="0,0,0,6"/>
        <TextBox x:Name="TaskArgumentsInput" Text="{Binding EditingTask.Arguments,UpdateSourceTrigger=PropertyChanged}"/>
      </StackPanel>
    </Grid>
    <Grid x:Name="TaskTimingRow" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid x:Name="TaskScheduleFields">
        <StackPanel>
          <TextBlock Text="定时启动" Margin="0,0,0,6"/>
          <v:TaskTimeSelector x:Name="TaskStartTimeSelector" Time="{Binding EditingTask.ScheduledStartTime,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Grid>
      <Grid x:Name="TaskDurationFields" Grid.Column="2">
        <StackPanel>
          <TextBlock Text="最大运行时间" Margin="0,0,0,6"/>
          <Grid>
            <TextBox x:Name="TaskDurationInput" Text="{Binding EditingTask.MaxRunMinutes,UpdateSourceTrigger=PropertyChanged}" Padding="8,5,48,5"/>
            <TextBlock Text="分钟" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#6D7F9D" IsHitTestVisible="False"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Grid>
    <TextBlock x:Name="GroupScheduleHint" Text="启动时间和任务间隔由所属任务组统一设置；最长运行时间按每项任务自身设置。" TextWrapping="Wrap" Foreground="#6E7F99" Visibility="Collapsed" Margin="0,0,0,12"/>
    <TextBlock Text="任务说明" Margin="0,0,0,6"/>
    <TextBox x:Name="TaskDescriptionInput" Text="{Binding EditingTask.Description,UpdateSourceTrigger=PropertyChanged}" Height="104" MinHeight="104" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
  </StackPanel>
</ScrollViewer>
                </Grid>
              </DockPanel>
            </Border>
            <v:SettingsPage x:Name="GlobalSettingsPage" Visibility="Collapsed"/>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
