<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>GameDayWork</AssemblyName>
    <RootNamespace>GameOrchestrator</RootNamespace>
    <Version>5.0.1</Version>
    <ApplicationIcon>Assets\GameDayWork.ico</ApplicationIcon>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="GameDayWork.Core\**\*.cs" />
    <Compile Remove="GameDayWork.Service\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <EmbeddedResource Remove="GameDayWork.Core\**\*" />
    <EmbeddedResource Remove="GameDayWork.Service\**\*" />
    <Page Remove="tests\**\*.xaml" />
    <Page Remove="GameDayWork.Core\**\*.xaml" />
    <Page Remove="GameDayWork.Service\**\*.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Services\LockScreenPowerPolicy.cs" />
    <Compile Remove="Services\RestartPolicy.cs" />
    <Compile Remove="Services\GameDayWorkServiceManager.cs" />
    <ProjectReference Include="GameDayWork.Core\GameDayWork.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\GameDayWork-Idle.ico" />
    <Resource Include="Assets\GameDayWork-Running.ico" />
  </ItemGroup>
</Project>
